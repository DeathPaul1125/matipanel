# /etc/sudoers.d/matipanel
# Acciones privilegiadas autorizadas sin password.
# Instalar con: sudo cp scripts/matipanel.sudoers /etc/sudoers.d/matipanel
#               sudo chmod 0440 /etc/sudoers.d/matipanel
#               sudo visudo -c

%matipanel ALL=(root) NOPASSWD: /bin/systemctl, /usr/bin/systemctl
%matipanel ALL=(root) NOPASSWD: /usr/sbin/ufw status *
%matipanel ALL=(root) NOPASSWD: /usr/bin/firewall-cmd --list-all-zones
%matipanel ALL=(root) NOPASSWD: /usr/bin/firewall-cmd --get-default-zone
%matipanel ALL=(root) NOPASSWD: /usr/sbin/iptables -L *
%matipanel ALL=(root) NOPASSWD: /usr/bin/apt update, /usr/bin/apt list *
%matipanel ALL=(root) NOPASSWD: /usr/bin/dnf check-update *, /usr/bin/dnf updateinfo *
