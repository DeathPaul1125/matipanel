[Unit]
Description=MatiPanel - Administrador de servidor Linux
After=network.target

[Service]
Type=simple
# Corre como root (igual que Webmin): necesario para PAM, la terminal con
# el usuario logueado, systemctl, firewall y edición de archivos.
WorkingDirectory=/opt/matipanel
Environment="PATH=/opt/matipanel/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/var/lib/matipanel"
Environment="MATIPANEL_SECURE_COOKIE=1"
ExecStart=/opt/matipanel/venv/bin/gunicorn \
    --worker-class gevent \
    --workers 1 \
    --worker-connections 100 \
    --bind 0.0.0.0:8443 \
    --certfile /etc/matipanel/cert.pem \
    --keyfile /etc/matipanel/key.pem \
    --timeout 86400 \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
